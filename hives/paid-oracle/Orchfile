# paid-oracle: a price sold per call for USDC. Set an ARG in the
# environment of `hum hive paid-oracle install` to change it, for example
# PAID_ORACLE_PAY_TO=0xYourAddr. An empty ARG keeps the attendant's own
# default; the README says what each one is. PAID_ORACLE_PAY_TO has no
# default, and the bee does not start without it.

ARG HUM_SRC=
ARG PAID_ORACLE_PAY_TO=
ARG PAID_ORACLE_RPC=
ARG PAID_ORACLE_CHAIN=
ARG PAID_ORACLE_PAY_KIND=
ARG PAID_ORACLE_USDC=
ARG PAID_ORACLE_DECIMALS=
ARG PAID_ORACLE_CONFIRMATIONS=
ARG PAID_ORACLE_PRICE_URL=

SERVICE hive-install
RUN ${HUM_SRC}/install
ONESHOT true

SERVICE paid-oracle
RUN ${HUM_SRC}/target/release/paid-oracle
ENV PAID_ORACLE_PAY_TO=${PAID_ORACLE_PAY_TO}
ENV PAID_ORACLE_RPC=${PAID_ORACLE_RPC}
ENV PAID_ORACLE_CHAIN=${PAID_ORACLE_CHAIN}
ENV PAID_ORACLE_PAY_KIND=${PAID_ORACLE_PAY_KIND}
ENV PAID_ORACLE_USDC=${PAID_ORACLE_USDC}
ENV PAID_ORACLE_DECIMALS=${PAID_ORACLE_DECIMALS}
ENV PAID_ORACLE_CONFIRMATIONS=${PAID_ORACLE_CONFIRMATIONS}
ENV PAID_ORACLE_PRICE_URL=${PAID_ORACLE_PRICE_URL}
RESTART always
