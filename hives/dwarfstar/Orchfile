ENV DWARFSTAR_DIR=${DWARFSTAR_DIR}
ENV DWARFSTAR_CTX=${DWARFSTAR_CTX}
ENV DWARFSTAR_MAX_TOKENS=${DWARFSTAR_MAX_TOKENS}
ENV DWARFSTAR_IDLE_MS=${DWARFSTAR_IDLE_MS}
ENV DWARFSTAR_THREADS=${DWARFSTAR_THREADS}
ENV DWARFSTAR_SSD_STREAMING=1
ENV DS4_LOCK_FILE=${DS4_LOCK_FILE}
ENV DWARFSTAR_GPU_LOCK=${HUM_HIVE_STATE}/gpu.lock
MEMORY 96G
RESTART on-failure
RESTART_DELAY 5s
START_LIMIT_BURST 3
START_LIMIT_INTERVAL 1m
TIMEOUT_STOP 30s

SERVICE ds41flash-q2
RUN nice -n 10 ${HUM_SRC}/out/dwarfstar-bee
ENV DWARFSTAR_LABEL=ds41flash-q2
ENV DWARFSTAR_MODEL=${DS41FLASH_Q2_MODEL}
ENV DWARFSTAR_MODELS=deepseek-v4.1-flash,deepseek-v4.1-flash-q2
ENV DWARFSTAR_DIR=${DWARFSTAR_DIR}
ENV DWARFSTAR_CTX=${DWARFSTAR_CTX}
ENV DWARFSTAR_MAX_TOKENS=${DWARFSTAR_MAX_TOKENS}
ENV DWARFSTAR_IDLE_MS=${DWARFSTAR_IDLE_MS}
ENV DWARFSTAR_THREADS=${DWARFSTAR_THREADS}
ENV DWARFSTAR_SSD_STREAMING=1
ENV DS4_LOCK_FILE=${DS4_LOCK_FILE}
ENV DWARFSTAR_GPU_LOCK=${HUM_HIVE_STATE}/gpu.lock
MEMORY 104G
RESTART on-failure
RESTART_DELAY 5s
START_LIMIT_BURST 3
START_LIMIT_INTERVAL 1m
TIMEOUT_STOP 30s

SERVICE glm53flash-q2
RUN nice -n 10 ${HUM_SRC}/out/dwarfstar-bee
ENV DWARFSTAR_LABEL=glm53flash-q2
ENV DWARFSTAR_MODEL=${GLM53FLASH_Q2_MODEL}
ENV DWARFSTAR_MODELS=glm-5.3-flash,glm-5.3-flash-q2
ENV DWARFSTAR_DIR=${DWARFSTAR_DIR}
ENV DWARFSTAR_CTX=${DWARFSTAR_CTX}
ENV DWARFSTAR_MAX_TOKENS=${DWARFSTAR_MAX_TOKENS}
ENV DWARFSTAR_IDLE_MS=${DWARFSTAR_IDLE_MS}
ENV DWARFSTAR_THREADS=${DWARFSTAR_THREADS}
ENV DWARFSTAR_SSD_STREAMING=1
ENV DS4_LOCK_FILE=${DS4_LOCK_FILE}
ENV DWARFSTAR_GPU_LOCK=${HUM_HIVE_STATE}/gpu.lock
