# dwarfstar: one unit per model, and each unit is its own bee.
#
# Every unit runs the same dwarfstar-bee, pinned to one GGUF and entered
# under its own label, so each model nestles with its own key, ids and
# headroom. A unit whose model is not on this machine logs so and stays
# down. The bees share the GPU through one lock: a model loads only when
# a prompt for it arrives, and hands the GPU to another model's bee when
# idle or asked. Set an ARG in the environment of
# `hum hive ./hives/dwarfstar install` to change it, for example
# DWARFSTAR_DIR=~/projects/ds4.
#
# MEMORY is the model's resident size with room for its KV cache.
# launchd records it as a soft resident-set limit and macOS does not
# enforce it; systemd enforces it as MemoryMax.

ARG HUM_SRC=
ARG HUM_HIVE_STATE=
ARG DWARFSTAR_DIR=
ARG DWARFSTAR_CTX=32768
ARG DWARFSTAR_MAX_TOKENS=4096
ARG DWARFSTAR_IDLE_MS=300000
ARG DWARFSTAR_THREADS=8
ARG DS4_LOCK_FILE=/tmp/ds4.lock
ARG DS4FLASH_MODEL=ds4flash.gguf
ARG DS4FLASH_Q2_MODEL=gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix-0731.gguf
ARG DS41FLASH_Q2_MODEL=gguf/DeepSeek-V4.1-Flash-1017-IQ2_XXS-Q2_K-imatrix.gguf
ARG GLM53FLASH_Q2_MODEL=gguf/GLM-5.3-Flash-Q2.gguf

SERVICE hive-install
RUN ${HUM_SRC}/install
ONESHOT true

SERVICE ds4flash
RUN nice -n 10 ${HUM_SRC}/out/dwarfstar-bee
ENV DWARFSTAR_LABEL=ds4flash
ENV DWARFSTAR_MODEL=${DS4FLASH_MODEL}
ENV DWARFSTAR_MODELS=deepseek-v4-flash
ENV DWARFSTAR_DIR=${DWARFSTAR_DIR}
ENV DWARFSTAR_CTX=${DWARFSTAR_CTX}
ENV DWARFSTAR_MAX_TOKENS=${DWARFSTAR_MAX_TOKENS}
ENV DWARFSTAR_IDLE_MS=${DWARFSTAR_IDLE_MS}
ENV DWARFSTAR_THREADS=${DWARFSTAR_THREADS}
ENV DWARFSTAR_SSD_STREAMING=1
ENV DS4_LOCK_FILE=${DS4_LOCK_FILE}
ENV DWARFSTAR_GPU_LOCK=${HUM_HIVE_STATE}/gpu.lock
MEMORY 104G
RESTART on-failure
RESTART_DELAY 5s
START_LIMIT_BURST 3
START_LIMIT_INTERVAL 1m
TIMEOUT_STOP 30s

SERVICE ds4flash-q2
RUN nice -n 10 ${HUM_SRC}/out/dwarfstar-bee
ENV DWARFSTAR_LABEL=ds4flash-q2
ENV DWARFSTAR_MODEL=${DS4FLASH_Q2_MODEL}
