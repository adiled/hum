#!/usr/bin/env bash
# Build the dwarfstar hive.
#
# The hive is a kind; this makes its material — the engine's source and
# the bee that stands for the engine. The Orchfile's RUN calls this, so
# the hive needs no knowledge outside its own directory, and nothing is
# installed into the system's PATH: the bee is built here and runs here.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$here"

make

echo "built ${here}/out/dwarfstar-bee"
