#!/usr/bin/env bash
# Build this hive's package.
#
# The hive is a kind; this makes its material. The Orchfile's hive-install
# runs this when a humd installs the hive, so the hive needs no knowledge
# outside its own directory, and nothing is installed into the system's
# PATH: the package is built here, and its bees run in the apps that
# depend on this directory.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$here"

if command -v pnpm >/dev/null 2>&1; then
  pnpm install --silent
  pnpm run build --silent
else
  npm install --silent
  npm run build --silent
fi
