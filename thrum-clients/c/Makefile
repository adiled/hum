# thrum-clients/c: the C reference client.
#
#   make          libthrum.a, the tests and the example bee
#   make test     run the tests against the golden fixture
#   make clean    drop out/
#
# The registry and the views (thrum/chi.h, thrum/protocol.h) are
# generated by `cargo run -p codegen`. Everything else is written here
# over libsodium and cJSON; see thrum.mk for the flags.

include thrum.mk

BUILD := $(THRUM_BUILD)
GOLDEN := ../../thrum-core/tests/fixtures/golden.ndjson

.PHONY: all test clean

all: $(THRUM_LIB) $(BUILD)/test_thrum $(BUILD)/echo_bee

$(BUILD)/test_thrum: tests/test_thrum.c $(THRUM_LIB) $(THRUM_HDR)
	@mkdir -p $(dir $@)
	$(CC) $(THRUM_CC_FLAGS) $(THRUM_CFLAGS) -o $@ $< $(THRUM_LIBS)

$(BUILD)/echo_bee: examples/echo_bee.c $(THRUM_LIB) $(THRUM_HDR)
	@mkdir -p $(dir $@)
	$(CC) $(THRUM_CC_FLAGS) $(THRUM_CFLAGS) -o $@ $< $(THRUM_LIBS)

test: $(BUILD)/test_thrum
	$(BUILD)/test_thrum $(GOLDEN)

clean:
	rm -rf $(BUILD)
