# thrum-clients/c: the C client.
#
#   make          libthrum.a, the views test and the echo bee
#   make test     check the views against the golden fixture
#   make clean    drop out/
#
# Every source under thrum/ is generated by `cargo run -p codegen`: the
# registry and the views from thrum-core, the client from
# codegen/templates/c. The client runs `hum bee link`; thrum.mk carries
# the flags.

include thrum.mk

BUILD := $(THRUM_BUILD)
GOLDEN := ../../thrum-core/tests/fixtures/golden.ndjson

.PHONY: all test clean

all: $(THRUM_LIB) $(BUILD)/test_views $(BUILD)/echo_bee

$(BUILD)/test_views: tests/test_views.c $(THRUM_LIB) $(THRUM_HDR)
	@mkdir -p $(dir $@)
	$(CC) $(THRUM_CC_FLAGS) $(THRUM_CFLAGS) -o $@ $< $(THRUM_LIBS)

$(BUILD)/echo_bee: examples/echo_bee.c $(THRUM_LIB) $(THRUM_HDR)
	@mkdir -p $(dir $@)
	$(CC) $(THRUM_CC_FLAGS) $(THRUM_CFLAGS) -o $@ $< $(THRUM_LIBS)

test: $(BUILD)/test_views
	$(BUILD)/test_views $(GOLDEN)

clean:
	rm -rf $(BUILD)
