# thrum-clients/c — the C reference client.
#
# The wire spec is the contract; this is C's mirror of it. The registry
# and the primitives (chi.h, helpers.h, protocol.h) are generated by
# codegen, so they cannot drift from the Rust registry. The socket loop
# is written by hand, the way every other client's is.
#
#   make          build the library and the tests
#   make test     run the tests
#   make install  copy the headers where a hive can find them

CC      ?= cc
CFLAGS  ?= -O2 -std=c11 -Wall -Wextra -D_POSIX_C_SOURCE=200809L
BUILD   ?= out
INCLUDE := -I.

SRC     := thrum/json.c thrum/client.c
OBJ     := $(patsubst thrum/%.c,$(BUILD)/thrum/%.o,$(SRC))
TEST    := $(BUILD)/test_client

.PHONY: all test clean install

all: $(TEST)

$(BUILD)/thrum/%.o: thrum/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDE) -c -o $@ $<

$(TEST): tests/test_client.c $(OBJ)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(INCLUDE) -o $@ tests/test_client.c $(OBJ)

test: $(TEST)
	./$(TEST)

install:
	install -d $(DESTDIR)/usr/local/include/thrum
	install -m 0644 thrum/chi.h thrum/helpers.h thrum/protocol.h thrum/json.h thrum/client.h \
		$(DESTDIR)/usr/local/include/thrum/

clean:
	rm -rf $(BUILD)
